<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia.Tight"
             xmlns:views="clr-namespace:ShiroBot.Plugin.GithubView.Views"
             x:Class="ShiroBot.Plugin.GithubView.Views.ReleaseCard"
             x:DataType="views:ReleaseCardViewModel"
             Width="700">

    <Design.DataContext>
        <views:ReleaseCardViewModel/>
    </Design.DataContext>

    <Border Background="#FFFFFF"
            CornerRadius="10"
            BorderBrush="#D0D7DE"
            BorderThickness="1"
            ClipToBounds="True">
        <StackPanel Margin="28,24" Spacing="14">

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" FontSize="14" Foreground="#57606A">
                    <Run Text="{Binding RepoSlug}"/>
                    <Run Text=" · Releases"/>
                </TextBlock>
                <Path Grid.Column="1"
                      Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
                      Fill="#8C959F" Width="22" Height="22" Stretch="Uniform"/>
            </Grid>

            <!-- 名称 + 徽章 -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Path Data="M1 7.775V2.75C1 1.784 1.784 1 2.75 1h5.025c.464 0 .91.184 1.238.513l6.25 6.25a1.75 1.75 0 0 1 0 2.474l-5.026 5.026a1.75 1.75 0 0 1-2.474 0l-6.25-6.25A1.75 1.75 0 0 1 1 7.775Zm1.5 0c0 .066.026.13.073.177l6.25 6.25a.25.25 0 0 0 .354 0l5.025-5.025a.25.25 0 0 0 0-.354l-6.25-6.25a.25.25 0 0 0-.177-.073H2.75a.25.25 0 0 0-.25.25ZM6 5a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z"
                      Fill="#57606A" Width="20" Height="20" Stretch="Uniform"
                      VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ReleaseName}"
                           FontSize="26" FontWeight="Bold"
                           Foreground="#24292F"
                           VerticalAlignment="Center"
                           MaxWidth="440"
                           TextTrimming="CharacterEllipsis"/>
                <Border Background="#DAFBE1" BorderBrush="#1A7F37" BorderThickness="1"
                        CornerRadius="12" Padding="10,2,10,3"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsLatest}">
                    <TextBlock Text="Latest" FontSize="13" Foreground="#1A7F37"/>
                </Border>
                <Border Background="#FFF8C5" BorderBrush="#BF8700" BorderThickness="1"
                        CornerRadius="12" Padding="10,2,10,3"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsPreRelease}">
                    <TextBlock Text="Pre-release" FontSize="13" Foreground="#9A6700"/>
                </Border>
            </StackPanel>

            <!-- 作者 + 元信息 -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Width="24" Height="24" CornerRadius="12"
                        ClipToBounds="True" Background="#EAEEF2"
                        VerticalAlignment="Center"
                        IsVisible="{Binding HasAuthorAvatar}">
                    <Image Source="{Binding AuthorAvatar}" Stretch="UniformToFill"/>
                </Border>
                <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="#57606A">
                    <Run Text="{Binding AuthorLogin}" FontWeight="SemiBold" Foreground="#24292F"/>
                    <Run Text=" "/>
                    <Run Text="{Binding MetaText}"/>
                </TextBlock>
                <Border Background="#EAEEF2" CornerRadius="6" Padding="8,3"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding TagText}"
                               FontSize="13"
                               FontFamily="Menlo,Consolas,monospace"
                               Foreground="#57606A"/>
                </Border>
                <TextBlock Text="{Binding AssetsText}"
                           IsVisible="{Binding HasAssets}"
                           FontSize="14"
                           Foreground="#57606A"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Release notes,超高裁剪 -->
            <Border IsVisible="{Binding HasBody}"
                    Background="#F6F8FA"
                    CornerRadius="8"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    Padding="16,12">
                <StackPanel Spacing="8">
                    <Border MaxHeight="{Binding BodyMaxHeight}"
                            VerticalAlignment="Top"
                            ClipToBounds="True">
                        <md:MarkdownScrollViewer Markdown="{Binding Body}"
                                                 VerticalAlignment="Top"
                                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </Border>
                    <TextBlock Text="…内容过长已截断"
                               IsVisible="{Binding ShowTruncatedNote}"
                               FontSize="13"
                               Foreground="#8C959F"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</UserControl>

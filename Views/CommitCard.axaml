<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ShiroBot.Plugin.GithubView.Views"
             x:Class="ShiroBot.Plugin.GithubView.Views.CommitCard"
             x:DataType="views:CommitCardViewModel"
             Width="700">

    <Design.DataContext>
        <views:CommitCardViewModel/>
    </Design.DataContext>

    <Border Background="#FFFFFF"
            CornerRadius="10"
            BorderBrush="#D0D7DE"
            BorderThickness="1"
            ClipToBounds="True">
        <StackPanel Margin="28,24" Spacing="14">

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" FontSize="14" Foreground="#57606A">
                    <Run Text="{Binding RepoSlug}"/>
                    <Run Text=" · Commit"/>
                </TextBlock>
                <Path Grid.Column="1"
                      Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
                      Fill="#8C959F" Width="22" Height="22" Stretch="Uniform"/>
            </Grid>

            <!-- Commit message -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Data="M11.93 8.5a4.002 4.002 0 0 1-7.86 0H.75a.75.75 0 0 1 0-1.5h3.32a4.002 4.002 0 0 1 7.86 0h3.32a.75.75 0 0 1 0 1.5Zm-1.43-.75a2.5 2.5 0 1 0-5 0 2.5 2.5 0 0 0 5 0Z"
                      Fill="#57606A" Width="20" Height="20" Stretch="Uniform"
                      VerticalAlignment="Top" Margin="0,7,0,0"/>
                <TextBlock Text="{Binding MessageTitle}"
                           FontSize="23" FontWeight="SemiBold"
                           Foreground="#24292F"
                           TextWrapping="Wrap"
                           MaxLines="3"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="580"
                           LineHeight="31"/>
            </StackPanel>

            <!-- message body -->
            <Border IsVisible="{Binding HasMessageBody}"
                    Background="#F6F8FA"
                    CornerRadius="8"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    Padding="16,10">
                <TextBlock Text="{Binding MessageBody}"
                           FontSize="14"
                           FontFamily="Menlo,Consolas,monospace"
                           Foreground="#57606A"
                           TextWrapping="Wrap"
                           MaxLines="8"
                           TextTrimming="CharacterEllipsis"/>
            </Border>

            <!-- 作者 + sha -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Width="24" Height="24" CornerRadius="12"
                        ClipToBounds="True" Background="#EAEEF2"
                        VerticalAlignment="Center"
                        IsVisible="{Binding HasAuthorAvatar}">
                    <Image Source="{Binding AuthorAvatar}" Stretch="UniformToFill"/>
                </Border>
                <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="#57606A">
                    <Run Text="{Binding AuthorLogin}" FontWeight="SemiBold" Foreground="#24292F"/>
                    <Run Text=" "/>
                    <Run Text="{Binding MetaText}"/>
                </TextBlock>
                <Border Background="#EAEEF2" CornerRadius="6" Padding="8,3"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding ShaText}"
                               FontSize="13"
                               FontFamily="Menlo,Consolas,monospace"
                               Foreground="#57606A"/>
                </Border>
            </StackPanel>

            <!-- 变更统计 -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding FilesText}"
                           FontSize="15"
                           Foreground="#24292F"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding AdditionsText}"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="#1A7F37"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding DeletionsText}"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="#CF222E"
                           VerticalAlignment="Center"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>

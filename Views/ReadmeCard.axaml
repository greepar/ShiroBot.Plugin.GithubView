<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia.Tight"
             xmlns:views="clr-namespace:ShiroBot.Plugin.GithubView.Views"
             x:Class="ShiroBot.Plugin.GithubView.Views.ReadmeCard"
             x:DataType="views:ReadmeCardViewModel"
             Width="700">

    <Design.DataContext>
        <views:ReadmeCardViewModel/>
    </Design.DataContext>

    <Border Background="#FFFFFF"
            CornerRadius="10"
            BorderBrush="#D0D7DE"
            BorderThickness="1"
            ClipToBounds="True">
        <StackPanel>

            <!-- 头部 -->
            <Border Background="#F6F8FA" Padding="28,16" BorderBrush="#D0D7DE" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Path Grid.Column="0"
                          Data="M0 1.75A.75.75 0 0 1 .75 1h4.253c1.227 0 2.317.59 3 1.501A3.743 3.743 0 0 1 11.006 1h4.245a.75.75 0 0 1 .75.75v10.5a.75.75 0 0 1-.75.75h-4.507a2.25 2.25 0 0 0-1.591.659l-.622.621a.75.75 0 0 1-1.06 0l-.622-.621A2.25 2.25 0 0 0 5.258 13H.75a.75.75 0 0 1-.75-.75Zm7.251 10.324.004-5.073-.002-2.253A2.25 2.25 0 0 0 5.003 2.5H1.5v9h3.757a3.75 3.75 0 0 1 1.994.574ZM8.755 4.75l-.004 7.322a3.752 3.752 0 0 1 1.992-.572H14.5v-9h-3.495a2.25 2.25 0 0 0-2.25 2.25Z"
                          Fill="#57606A" Width="17" Height="17" Stretch="Uniform"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="15">
                        <Run Text="{Binding RepoSlug}" Foreground="#57606A"/>
                        <Run Text=" / " Foreground="#8C959F"/>
                        <Run Text="{Binding FileName}" FontWeight="SemiBold" Foreground="#24292F"/>
                    </TextBlock>
                    <Path Grid.Column="2"
                          Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
                          Fill="#8C959F" Width="22" Height="22" Stretch="Uniform"
                          VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Markdown 正文,超高裁剪 -->
            <StackPanel Margin="28,20,28,24" Spacing="10">
                <Border MaxHeight="{Binding BodyMaxHeight}"
                        VerticalAlignment="Top"
                        ClipToBounds="True">
                    <md:MarkdownScrollViewer Markdown="{Binding Markdown}"
                                             VerticalAlignment="Top"
                                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </Border>
                <TextBlock Text="…内容过长已截断,完整内容请访问仓库页面"
                           IsVisible="{Binding ShowTruncatedNote}"
                           FontSize="13"
                           Foreground="#8C959F"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>

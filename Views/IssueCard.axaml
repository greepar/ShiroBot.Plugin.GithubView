<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ShiroBot.Plugin.GithubView.Views"
             xmlns:md="clr-namespace:ShiroBot.Plugin.GithubView.Markdown"
             x:Class="ShiroBot.Plugin.GithubView.Views.IssueCard"
             x:DataType="views:IssueCardViewModel"
             Width="760">

    <Design.DataContext>
        <views:IssueCardViewModel/>
    </Design.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <views:GitHubTheme/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.value">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Gh.Fg}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource Gh.FgMuted}"/>
            <Setter Property="Margin" Value="24,4,0,0"/>
        </Style>
        <Style Selector="Path.icon">
            <Setter Property="Fill" Value="{DynamicResource Gh.FgMuted}"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 时间线条目：Issue 作者的发言用强调色 -->
        <Style Selector="Border.entry">
            <Setter Property="BorderBrush" Value="{DynamicResource Gh.Border}"/>
        </Style>
        <Style Selector="Border.entry.author">
            <Setter Property="BorderBrush" Value="{DynamicResource Gh.AccentBorder}"/>
        </Style>
        <Style Selector="Border.entryHeader">
            <Setter Property="Background" Value="{DynamicResource Gh.CanvasSubtle}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Gh.Border}"/>
        </Style>
        <Style Selector="Border.entryHeader.author">
            <Setter Property="Background" Value="{DynamicResource Gh.AccentSubtle}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Gh.AccentBorder}"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource Gh.Canvas}"
            CornerRadius="6"
            ClipToBounds="True">
        <StackPanel>

            <!-- 头部 -->
            <StackPanel Spacing="14" Margin="32,30,32,0">

                <!-- 仓库 + 编号 -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="icon" Width="18" Height="18"
                          Data="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.249.249 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z"/>
                    <TextBlock Text="{Binding RepositoryDisplay}"
                               FontSize="18"
                               Foreground="{DynamicResource Gh.FgMuted}"
                               VerticalAlignment="Center"
                               MaxWidth="520"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding NumberDisplay}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Gh.FgSubtle}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 标题 -->
                <TextBlock Text="{Binding Title}"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Gh.Fg}"
                           LineHeight="37"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="3"/>

                <!-- 状态徽章 + 元信息 -->
                <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0" Height="32" CornerRadius="16" Padding="12,0,14,0" VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush Color="{Binding StateColor}"/>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Path Data="{Binding StateIcon}" Fill="#FFFFFF"
                                  Width="16" Height="16" Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StateText}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               FontSize="15"
                               Foreground="{DynamicResource Gh.FgMuted}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="2">
                        <Run Text="{Binding Author}" FontWeight="SemiBold" Foreground="{DynamicResource Gh.Fg}"/>
                        <Run Text="{Binding MetaSuffix}"/>
                    </TextBlock>
                </Grid>

                <!-- PR 分支 -->
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsPullRequest}">
                    <Border Background="{DynamicResource Gh.AccentSubtle}" CornerRadius="6" Height="26" Padding="8,0">
                        <TextBlock Text="{Binding BaseBranch}" FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
                                   FontSize="13.5" Foreground="{DynamicResource Gh.Link}" VerticalAlignment="Center"
                                   MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Path Classes="icon" Width="14" Height="14"
                          Data="M7.78 12.53a.75.75 0 0 1-1.06 0L2.47 8.28a.75.75 0 0 1 0-1.06l4.25-4.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042L4.81 7h7.44a.75.75 0 0 1 0 1.5H4.81l2.97 2.97a.75.75 0 0 1 0 1.06Z"/>
                    <Border Background="{DynamicResource Gh.AccentSubtle}" CornerRadius="6" Height="26" Padding="8,0">
                        <TextBlock Text="{Binding HeadBranch}" FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
                                   FontSize="13.5" Foreground="{DynamicResource Gh.Link}" VerticalAlignment="Center"
                                   MaxWidth="380" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </StackPanel>

                <!-- 标签 -->
                <ItemsControl ItemsSource="{Binding Labels}" IsVisible="{Binding HasLabels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="6" LineSpacing="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="views:IssueLabelViewModel">
                            <views:LabelChip Text="{Binding Name}" LabelColor="{Binding Color}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource Gh.Divider}" Margin="0,24,0,0"/>

            <!-- 时间线：正文 + 评论 -->
            <ItemsControl ItemsSource="{Binding Entries}" Margin="32,24,32,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="16"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:CommentViewModel">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0"
                                    Width="40" Height="40"
                                    CornerRadius="20"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource Gh.Placeholder}"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding Avatar}"
                                           IsVisible="{Binding HasAvatar}"
                                           Stretch="UniformToFill"/>
                                    <TextBlock Text="{Binding AuthorInitial}"
                                               IsVisible="{Binding HasNoAvatar}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1"
                                    Classes="entry"
                                    Classes.author="{Binding IsIssueAuthor}"
                                    Margin="12,0,0,0"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    ClipToBounds="True">
                                <StackPanel>
                                    <!-- 头部高度与头像一致，名字和徽章都居中 -->
                                    <Border Classes="entryHeader"
                                            Classes.author="{Binding IsIssueAuthor}"
                                            Height="40"
                                            Padding="16,0"
                                            BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" FontSize="14"
                                                       Foreground="{DynamicResource Gh.FgMuted}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Author}" FontWeight="SemiBold" Foreground="{DynamicResource Gh.Fg}"/>
                                                <Run Text="{Binding ActionText}"/>
                                            </TextBlock>
                                            <Border Grid.Column="1"
                                                    IsVisible="{Binding HasAssociation}"
                                                    BorderBrush="{DynamicResource Gh.Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="11"
                                                    Height="22"
                                                    Padding="8,0"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Association}" FontSize="12"
                                                           Foreground="{DynamicResource Gh.FgMuted}"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <md:MarkdownView Markdown="{Binding Content}" Margin="16,14,16,16"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding HiddenCommentsText}"
                       IsVisible="{Binding HasHiddenComments}"
                       Margin="84,14,32,0"
                       FontSize="14"
                       Foreground="{DynamicResource Gh.FgMuted}"/>

            <Border Height="1" Background="{DynamicResource Gh.Divider}" Margin="0,24,0,0"/>

            <!-- 统计 -->
            <Grid ColumnDefinitions="*,Auto" Margin="32,22,32,24">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="40" VerticalAlignment="Center">

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Data="M1 2.75C1 1.784 1.784 1 2.75 1h10.5c.966 0 1.75.784 1.75 1.75v7.5A1.75 1.75 0 0 1 13.25 12H9.06l-2.573 2.573A1.458 1.458 0 0 1 4 13.543V12H2.75A1.75 1.75 0 0 1 1 10.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h2a.75.75 0 0 1 .75.75v2.19l2.72-2.72a.749.749 0 0 1 .53-.22h4.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z"/>
                            <TextBlock Classes="value" Text="{Binding Comments}"/>
                        </StackPanel>
                        <TextBlock Classes="caption" Text="Comments"/>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsIssue}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Data="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0ZM1.5 8a6.5 6.5 0 1 0 13 0 6.5 6.5 0 0 0-13 0Zm3.82 1.636a.75.75 0 0 1 1.038.175l.007.009c.103.118.22.222.35.31.264.178.683.37 1.285.37.602 0 1.02-.192 1.285-.371.13-.088.247-.192.35-.31l.007-.008a.75.75 0 0 1 1.222.87C10.3 10.957 9.392 11.5 8 11.5c-1.392 0-2.3-.543-2.865-1.214a.75.75 0 0 1 .185-1.05ZM12 7a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM5 8a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"/>
                            <TextBlock Classes="value" Text="{Binding Reactions}"/>
                        </StackPanel>
                        <TextBlock Classes="caption" Text="Reactions"/>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsPullRequest}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Data="M11.93 8.5a4.002 4.002 0 0 1-7.86 0H.75a.75.75 0 0 1 0-1.5h3.32a4.002 4.002 0 0 1 7.86 0h3.32a.75.75 0 0 1 0 1.5Zm-1.43-.75a2.5 2.5 0 1 0-5 0 2.5 2.5 0 0 0 5 0Z"/>
                            <TextBlock Classes="value" Text="{Binding Commits}"/>
                        </StackPanel>
                        <TextBlock Classes="caption" Text="Commits"/>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsPullRequest}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Data="M1 1.75C1 .784 1.784 0 2.75 0h7.586c.464 0 .909.184 1.237.513l2.914 2.914c.329.328.513.773.513 1.237v9.586A1.75 1.75 0 0 1 13.25 16H2.75A1.75 1.75 0 0 1 1 14.25Zm1.75-.25a.25.25 0 0 0-.25.25v12.5c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25V4.664a.25.25 0 0 0-.073-.177l-2.914-2.914a.25.25 0 0 0-.177-.073ZM8 3.25a.75.75 0 0 1 .75.75v1.5h1.5a.75.75 0 0 1 0 1.5h-1.5v1.5a.75.75 0 0 1-1.5 0V7h-1.5a.75.75 0 0 1 0-1.5h1.5V4A.75.75 0 0 1 8 3.25Zm-3 8a.75.75 0 0 1 .75-.75h4.5a.75.75 0 0 1 0 1.5h-4.5a.75.75 0 0 1-.75-.75Z"/>
                            <TextBlock Classes="value" Text="{Binding ChangedFiles}"/>
                        </StackPanel>
                        <TextBlock Classes="caption" Text="Files changed"/>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsPullRequest}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Data="M8.75 1.75V5H12a.75.75 0 0 1 0 1.5H8.75v3.25a.75.75 0 0 1-1.5 0V6.5H4A.75.75 0 0 1 4 5h3.25V1.75a.75.75 0 0 1 1.5 0ZM4 13h8a.75.75 0 0 1 0 1.5H4A.75.75 0 0 1 4 13Z"/>
                            <TextBlock Classes="value" Text="{Binding Additions}" Foreground="{DynamicResource Gh.Success}"/>
                            <TextBlock Classes="value" Text="{Binding Deletions}" Foreground="{DynamicResource Gh.Danger}"/>
                        </StackPanel>
                        <TextBlock Classes="caption" Text="Lines changed"/>
                    </StackPanel>
                </StackPanel>

                <Path Grid.Column="1" Classes="icon" Width="30" Height="30"
                      Fill="{DynamicResource Gh.FgSubtle}"
                      Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
            </Grid>

            <!-- 状态色条 -->
            <Border Height="8">
                <Border.Background>
                    <SolidColorBrush Color="{Binding StateColor}"/>
                </Border.Background>
            </Border>
        </StackPanel>
    </Border>
</UserControl>

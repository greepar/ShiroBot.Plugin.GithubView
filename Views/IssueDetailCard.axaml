<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia.Tight"
             xmlns:views="clr-namespace:ShiroBot.Plugin.GithubView.Views"
             x:Class="ShiroBot.Plugin.GithubView.Views.IssueDetailCard"
             x:DataType="views:IssueDetailCardViewModel"
             Width="700">

    <Design.DataContext>
        <views:IssueDetailCardViewModel/>
    </Design.DataContext>

    <Border Background="#FFFFFF"
            CornerRadius="10"
            BorderBrush="#D0D7DE"
            BorderThickness="1"
            ClipToBounds="True">
        <StackPanel Margin="28,24,28,24" Spacing="14">

            <!-- 顶部:repo 名 + GitHub logo -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding RepoSlug}"
                           FontSize="15"
                           Foreground="#57606A"/>
                <Path Grid.Column="1"
                      Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
                      Fill="#8C959F" Width="22" Height="22" Stretch="Uniform"/>
            </Grid>

            <!-- 标题 -->
            <TextBlock FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#24292F"
                       TextWrapping="Wrap"
                       MaxLines="3"
                       TextTrimming="CharacterEllipsis"
                       LineHeight="34">
                <Run Text="{Binding Title}"/>
                <Run Text=" "/>
                <Run Text="{Binding NumberText}" Foreground="#57606A" FontWeight="Light"/>
            </TextBlock>

            <!-- 状态胶囊 + 作者 + 元信息 -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Background="{Binding StateBrush}"
                        CornerRadius="16"
                        Padding="12,5,14,6">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Path Data="{Binding StateIconData}"
                              Fill="#FFFFFF" Width="15" Height="15" Stretch="Uniform"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StateText}"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Width="26" Height="26" CornerRadius="13"
                        ClipToBounds="True" Background="#EAEEF2"
                        VerticalAlignment="Center"
                        IsVisible="{Binding HasAuthorAvatar}">
                    <Image Source="{Binding AuthorAvatar}" Stretch="UniformToFill"/>
                </Border>

                <TextBlock VerticalAlignment="Center" FontSize="15" Foreground="#57606A">
                    <Run Text="{Binding AuthorLogin}" FontWeight="SemiBold" Foreground="#24292F"/>
                    <Run Text=" "/>
                    <Run Text="{Binding MetaText}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding CommentsText}"/>
                </TextBlock>
            </StackPanel>

            <!-- PR 分支 + diff -->
            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsPullRequest}">
                <Border Background="#DDF4FF" CornerRadius="6" Padding="8,3">
                    <TextBlock Text="{Binding BranchText}"
                               FontSize="13"
                               FontFamily="Menlo,Consolas,monospace"
                               Foreground="#0969DA"/>
                </Border>
                <TextBlock Text="{Binding DiffStatText}"
                           IsVisible="{Binding HasDiffStat}"
                           FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="#57606A"/>
            </StackPanel>

            <!-- Labels -->
            <ItemsControl ItemsSource="{Binding Labels}" IsVisible="{Binding HasLabels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:LabelChip">
                        <Border CornerRadius="12"
                                Padding="10,3,10,4"
                                Margin="0,0,6,6">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding Background}"/>
                            </Border.Background>
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding Foreground}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 正文 (Markdown),超高裁剪 -->
            <Border IsVisible="{Binding HasBody}"
                    Background="#F6F8FA"
                    CornerRadius="8"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    Padding="16,12">
                <StackPanel Spacing="8">
                    <Border MaxHeight="{Binding BodyMaxHeight}"
                            VerticalAlignment="Top"
                            ClipToBounds="True">
                        <md:MarkdownScrollViewer Markdown="{Binding Body}"
                                                 VerticalAlignment="Top"
                                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </Border>
                    <TextBlock Text="…内容过长已截断"
                               IsVisible="{Binding ShowTruncatedNote}"
                               FontSize="13"
                               Foreground="#8C959F"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</UserControl>

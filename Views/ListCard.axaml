<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ShiroBot.Plugin.GithubView.Views"
             x:Class="ShiroBot.Plugin.GithubView.Views.ListCard"
             x:DataType="views:ListCardViewModel"
             Width="700">

    <Design.DataContext>
        <views:ListCardViewModel/>
    </Design.DataContext>

    <Border Background="#FFFFFF"
            CornerRadius="10"
            BorderBrush="#D0D7DE"
            BorderThickness="1"
            ClipToBounds="True">
        <StackPanel>

            <!-- 头部 -->
            <Border Background="#F6F8FA" Padding="28,18" BorderBrush="#D0D7DE" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding RepoSlug}" FontSize="14" Foreground="#57606A"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding TitleText}"
                                       FontSize="22" FontWeight="Bold" Foreground="#24292F"/>
                            <TextBlock Text="{Binding SubTitleText}"
                                       IsVisible="{Binding HasSubTitle}"
                                       FontSize="15" Foreground="#57606A"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <Path Grid.Column="1"
                          VerticalAlignment="Center"
                          Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
                          Fill="#8C959F" Width="24" Height="24" Stretch="Uniform"/>
                </Grid>
            </Border>

            <!-- 空态 -->
            <TextBlock Text="{Binding EmptyText}"
                       IsVisible="{Binding IsEmpty}"
                       Margin="28,24"
                       FontSize="15"
                       Foreground="#8C959F"/>

            <!-- 列表 -->
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:ListItem">
                        <Border Padding="28,10" BorderBrush="#EAEEF2" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Path Grid.Column="0"
                                      Data="{Binding IconData}"
                                      Fill="{Binding IconBrush}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Margin="0,4,12,0"
                                      VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="#24292F"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SubText}"
                                               FontSize="13"
                                               Foreground="#57606A"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding RightText}"
                                           FontSize="13"
                                           Foreground="#8C959F"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </Border>
</UserControl>
